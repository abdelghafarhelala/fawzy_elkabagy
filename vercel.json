{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/restro-menu/browser",
  "framework": null,
  "headers": [
    {
      "source": "/:file(.*)-[A-Za-z0-9]{8}.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/:file(.*)-[A-Za-z0-9]{8}.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
