# Supabase (also mirrored in src/environments/environment.ts for Angular builds)
# Project: fawzy-elkabagy-live (mrcmlorpbveilbeaeqvu)
SUPABASE_URL=https://mrcmlorpbveilbeaeqvu.supabase.co
SUPABASE_ANON_KEY=

# Server-only: needed for scripts/upload-menu-images.mjs,
# scripts/upload-category-images.mjs, scripts/export-static-data.mjs,
# and the Vercel /api/publish function
# (never commit / never expose to the browser)
# Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Server-only (Vercel): fine-grained GitHub PAT with contents:write +
# actions:write on this repo — used by /api/publish to trigger the
# export-and-publish GitHub Action
GITHUB_TOKEN=
GITHUB_REPO=abdelghafarhelala/fawzy_elkabagy
GITHUB_WORKFLOW_FILE=publish-data.yml
GITHUB_REF=master
